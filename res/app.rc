#include <windows.h>

101 ICON "rueda.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "0C0A04B0"
    BEGIN
      VALUE "CompanyName", "@byalvaro__"
      VALUE "FileDescription", "Rueda Suprema"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductName", "Rueda Suprema"
      VALUE "ProductVersion", "1.0.0"
      VALUE "LegalCopyright", "HECHO POR @BYALVARO__"
      VALUE "OriginalFilename", "RuedaSuprema.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0C0A, 1200
  END
END
